# Copy to `.env.local` for local development. Never commit real secrets.

# --- Server-only (Firebase Admin) ---
# Firebase project ID used by Admin SDK on the server.
FIREBASE_PROJECT_ID=

# Service account email from Firebase Console → Project settings → Service accounts.
FIREBASE_CLIENT_EMAIL=

# Private key for the service account (use literal \n for newlines in .env files).
FIREBASE_PRIVATE_KEY=

# IANA timezone for daily picks and streak boundaries (fixed for this app).
APP_TIMEZONE=Asia/Kolkata

# --- Public (exposed to the browser; NEXT_PUBLIC_* only) ---
# Firebase web app config from Firebase Console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Point the web app at local Firebase emulators (see README).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Firebase Admin emulator wiring (server; set when running emulators) ---
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Tooling (optional) ---
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_PORT=3000
