# Copy to `.env.local` for local development. Never commit real secrets.

# --- Server-only (Firebase Admin) ---
# Firebase project ID used by Admin SDK on the server.
FIREBASE_PROJECT_ID=

# Service account email from Firebase Console → Project settings → Service accounts.
FIREBASE_CLIENT_EMAIL=

# Private key for the service account (use literal \n for newlines in .env files).
FIREBASE_PRIVATE_KEY=

# IANA timezone for daily picks and streak boundaries (fixed for this app).
APP_TIMEZONE=Asia/Kolkata

# --- Public (exposed to the browser; NEXT_PUBLIC_* only) ---
# Firebase web app config from Firebase Console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Tooling (optional) ---
# Playwright base URL when not using the default dev server.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_PORT=3000
